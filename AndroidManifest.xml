<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.omnirom.omnistyle"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Package visibility: find header packs installed by other apps -->
    <queries>
        <intent>
            <action android:name="org.omnirom.DaylightHeaderPack" />
        </intent>
        <intent>
            <action android:name="org.omnirom.DaylightHeaderPack1" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="OmniStyle"
        android:icon="@drawable/candy_icon"
        android:theme="@style/Theme.OmniStyle" >
        <activity
            android:name=".BrowseHeaderActivity"
            android:label="@string/omnistyle_browse_header"
            android:theme="@style/Theme.OmniStyle.NoActionBar"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PickHeaderActivity"
            android:label="@string/omnistyle_pick_header"
            android:theme="@style/Theme.OmniStyle.NoActionBar"
